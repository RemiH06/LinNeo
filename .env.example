# LinNeo: copia este archivo a .env y llena los valores.
# El backend y los fetchers lo leen desde la raíz del repo.

# Neo4j (password vacío = conexión sin autenticación, solo en local)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=linneo

# Xeno-canto API v3 (gratuita, en tu Account Page de xeno-canto.org)
XENO_CANTO_API_KEY=
