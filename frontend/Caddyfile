# Caddy de producción: sirve el build y pasa /api a la API. Cloudflare termina el
# TLS (túnel de 29.Bakery/publicacion), así que aquí no hay certificados ni admin.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Imágenes y sonidos llegan de muchas fuentes (Wikimedia, Zenodo, xeno-canto...):
		# cualquier https. Scripts, estilos, fuentes y fetch solo del propio sitio.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; media-src https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		-Server
	}

	handle_path /api/* {
		reverse_proxy api:8035
	}

	# Los assets llevan hash en el nombre y no cambian nunca. Uno que no existe da
	# 404 (no el index.html, que se guardaría como "immutable").
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		route {
			# index.html se revalida siempre: apunta a los assets de cada build.
			header Cache-Control "no-cache"
			header /fonts/* Cache-Control "public, max-age=2592000"
			# Rutas del SPA (/taxon/1, /mapa...) caen en index.html; React pinta su 404.
			try_files {path} /index.html
			file_server
		}
	}
}
